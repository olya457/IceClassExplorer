# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

SILENCED_CPP_PODS = ['fmt', 'Yoga'].freeze
FMT_HEADER_ONLY_FLAG = '-DFMT_HEADER_ONLY=1'.freeze
FMT_HEADER_ONLY_DEFINITION = 'FMT_HEADER_ONLY=1'.freeze
FMT_DISABLE_CONSTEVAL_FLAG = '-DFMT_USE_CONSTEVAL=0'.freeze
FMT_DISABLE_CONSTEVAL_DEFINITION = 'FMT_USE_CONSTEVAL=0'.freeze

def update_file_if_needed(path)
  return unless File.exist?(path)

  current = File.read(path)
  updated = yield current
  if updated != current
    File.chmod(File.stat(path).mode | 0o200, path) unless File.writable?(path)
    File.write(path, updated)
  end
end

def sanitize_react_native_podspecs!
  react_native_root = File.expand_path('../node_modules/react-native', __dir__)

  update_file_if_needed(File.join(react_native_root, 'ReactCommon/yoga/Yoga.podspec')) do |contents|
    contents.gsub(/(['"])-Werror\1,?/, "'-w',")
  end

  update_file_if_needed(File.join(react_native_root, 'third-party-podspecs/fmt.podspec')) do |contents|
    updated = contents
    unless updated.include?('"OTHER_CPLUSPLUSFLAGS"')
      updated = updated.sub(
        %q{"GCC_WARN_INHIBIT_ALL_WARNINGS" => "YES" # Disable warnings because we don't control this library},
        %q{"GCC_WARN_INHIBIT_ALL_WARNINGS" => "YES",
    "OTHER_CPLUSPLUSFLAGS" => "$(inherited) -DFMT_HEADER_ONLY=1 -w -Wno-error=return-type -Wno-error=non-modular-include-in-framework-module -Wno-error=deprecated-objc-isa-usage -Wno-error=objc-root-class"}
      )
    end
    updated = updated.gsub(/"OTHER_CPLUSPLUSFLAGS"\s*=>\s*"([^"]*)"/) do
      flags = Regexp.last_match(1).split
      flags << FMT_HEADER_ONLY_FLAG
      flags << FMT_DISABLE_CONSTEVAL_FLAG
      %Q{"OTHER_CPLUSPLUSFLAGS" => "#{flags.uniq.join(' ')}"}
    end
    unless updated.include?('"GCC_PREPROCESSOR_DEFINITIONS"')
      updated = updated.sub(
        /("OTHER_CPLUSPLUSFLAGS"\s*=>\s*"[^"]*")/,
        %Q{\\1,\n    "GCC_PREPROCESSOR_DEFINITIONS" => "$(inherited) #{FMT_HEADER_ONLY_DEFINITION} #{FMT_DISABLE_CONSTEVAL_DEFINITION}"}
      )
    else
      updated = updated.gsub(/"GCC_PREPROCESSOR_DEFINITIONS"\s*=>\s*"([^"]*)"/) do
        definitions = Regexp.last_match(1).split
        definitions << FMT_HEADER_ONLY_DEFINITION
        definitions << FMT_DISABLE_CONSTEVAL_DEFINITION
        %Q{"GCC_PREPROCESSOR_DEFINITIONS" => "#{definitions.uniq.join(' ')}"}
      end
    end
    updated = updated.gsub(
      'spec.source_files = ["include/fmt/*.h", "src/format.cc"]',
      'spec.source_files = ["include/fmt/*.h"]'
    )
    updated
  end
end

def patch_fmt_consteval_header!(pods_root)
  update_file_if_needed(File.join(pods_root, 'fmt/include/fmt/base.h')) do |contents|
    contents.sub(
      '#if !defined(__cpp_lib_is_constant_evaluated)',
      "#if defined(FMT_USE_CONSTEVAL)\n#elif !defined(__cpp_lib_is_constant_evaluated)"
    )
  end
end

platform :ios, min_ios_version_supported
prepare_react_native_project!
sanitize_react_native_podspecs!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'IceClassExplorer' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    patch_fmt_consteval_header!(installer.sandbox.root.to_s)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        build_config.build_settings['GCC_WARN_ABOUT_RETURN_TYPE'] = 'YES'
        build_config.build_settings['CLANG_WARN_OBJC_ROOT_CLASS'] = 'YES'
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        definitions = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
        definitions = definitions.is_a?(Array) ? definitions : definitions.split(' ')
        definitions << FMT_HEADER_ONLY_DEFINITION
        definitions << FMT_DISABLE_CONSTEVAL_DEFINITION
        build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions.uniq

        if SILENCED_CPP_PODS.include?(target.name)
          build_config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
          build_config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
          build_config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        end

        ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |key|
          value = build_config.build_settings[key]
          value = '$(inherited)' unless value

          flags = value.is_a?(Array) ? value : value.split(' ')
          filtered_flags = flags.reject { |flag| flag == '-Werror' || flag.start_with?('-Werror=') }
          filtered_flags << FMT_HEADER_ONLY_FLAG if key == 'OTHER_CPLUSPLUSFLAGS'
          filtered_flags << FMT_DISABLE_CONSTEVAL_FLAG if key == 'OTHER_CPLUSPLUSFLAGS'
          filtered_flags << '-Wno-error=return-type'
          filtered_flags << '-Wno-error=non-modular-include-in-framework-module'
          filtered_flags << '-Wno-error=deprecated-objc-isa-usage'
          filtered_flags << '-Wno-error=objc-root-class'
          filtered_flags << '-w' if SILENCED_CPP_PODS.include?(target.name)
          filtered_flags = filtered_flags.uniq
          build_config.build_settings[key] = value.is_a?(Array) ? filtered_flags : filtered_flags.join(' ')
        end
      end

      source_phase = target.respond_to?(:source_build_phase) ? target.source_build_phase : nil
      next unless source_phase

      source_phase.files.each do |file|
        next unless file.settings && file.settings['COMPILER_FLAGS']

        flags = file.settings['COMPILER_FLAGS'].split
        filtered_flags = flags.reject { |flag| flag == '-Werror' || flag.start_with?('-Werror=') }
        if SILENCED_CPP_PODS.include?(target.name)
          filtered_flags << '-w'
          filtered_flags << '-fno-modules'
        end
        file.settings['COMPILER_FLAGS'] = filtered_flags.uniq.join(' ')
      end
    end
  end
end
